{
  "name": "tafseer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "security:prepare": "node scripts/picomatch-mitigation.js",
    "security:check": "node scripts/picomatch-mitigation.js --check",
    "test:security": "node --test scripts/picomatch-mitigation.test.js",
    "postinstall": "npm run security:prepare",
    "predev": "npm run security:prepare",
    "prebuild": "npm run security:prepare",
    "prepreview": "npm run security:prepare"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.5.33",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.6",
    "vite": "^6.4.6"
  }
}
